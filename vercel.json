{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,.git/**,__pycache__/**,*.pyc,*.pyo,*.pyd,.venv/**,venv/**,*.db,*.db-*,.env*,*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}